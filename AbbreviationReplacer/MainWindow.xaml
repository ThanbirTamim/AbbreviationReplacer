<Window x:Class="AbbreviationReplacer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel Analyzer v2.0" Height="800" Width="1200"
        Background="#020502" FontFamily="Consolas">

    <Window.Resources>
        <Style x:Key="AbbrLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#00FF41" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1A331A"/>
            <Setter Property="Padding" Value="15,10,15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D260D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MilitaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A120A"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                <TextBlock Text="INTEL_CORE::ABBREVIATION_ENGINE" Foreground="#00FF41" 
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="SYSTEM STATUS: OPERATIONAL // ENCRYPTED_LINK_ACTIVE" Foreground="#336633" FontSize="11"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="[ LOAD_DOCX ]" Style="{StaticResource MilitaryButtonStyle}" Margin="8,0" Click="UploadDocx_Click"/>
                <Button Content="[ EXPORT_DOCX ]" Style="{StaticResource MilitaryButtonStyle}" Margin="8,0" Click="DownloadDocx_Click"/>
                <Button Content="[ SYNC_INTEL ]" Style="{StaticResource MilitaryButtonStyle}" Margin="8,0" Click="UploadExcel_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="> DATA_INGEST_BUFFER" Foreground="#00FF41" Opacity="0.7" FontSize="12" Margin="0,0,0,8"/>
            <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#050A05" Foreground="#D0FFD0"
                     BorderBrush="#1A331A" BorderThickness="1" Padding="15" FontSize="16"
                     CaretBrush="#00FF41" SelectionBrush="#00FF41"/>
        </Grid>

        <Button x:Name="ConvertButton" Grid.Row="2" Content="EXECUTE_ABBREVIATION_PROTOCOL" 
                Height="55" Margin="0,10" Background="#00FF41" Foreground="Black" 
                FontWeight="Bold" FontSize="18" BorderThickness="0"
                Click="ReplaceButton_Click" Cursor="Hand">
            <Button.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#00FF41" Opacity="0.5"/>
            </Button.Effect>
        </Button>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="> DECIPHERED_INTELLIGENCE_OUTPUT" Foreground="#00FF41" Opacity="0.7" FontSize="12" Margin="0,0,0,8"/>
            <RichTextBox x:Name="OutputRichTextBox" Grid.Row="1" IsReadOnly="True"
                         Background="#050A05" Foreground="#FFFFFF" BorderBrush="#00FF41" 
                         BorderThickness="1" Padding="15" FontSize="16" 
                         VerticalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="Hyperlink" BasedOn="{StaticResource AbbrLinkStyle}"/>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>

        <Popup x:Name="AbbrPopup" StaysOpen="False" AllowsTransparency="True" 
               Placement="MousePoint" PopupAnimation="Fade">
            <Border Background="#0A120A" BorderBrush="#00FF41" BorderThickness="1" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00FF41" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SELECT_OBJECTIVE" Foreground="#00FF41" 
                               FontSize="10" Margin="10,8,10,5" FontWeight="Bold" Opacity="0.5"/>
                    <Rectangle Fill="#1A331A" Height="1" Margin="5,0"/>
                    <StackPanel x:Name="PopupStackPanel" MinWidth="180"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>